# Monorepo-wide gitignore. Package-specific patterns live in each
# apps/*/.gitignore.

# PII: real driver-card data and parsed dumps (kept locally at the
# monorepo root for the desktop app's smoke test).
*.ddd
output.json
output.err

# macOS junk
.DS_Store

# Local reference clone of tachoparser (pulled as a Go module via go get,
# kept here for source inspection only). Not part of this repo.
/tachoparser/

# Legislation references: keep the grep-friendly .txt mirrors in-repo so
# the migration-plan citations resolve offline. The raw HTML downloads
# and browser-saved asset bundles are heavyweight (~55 MB combined) —
# keep them locally for fidelity, but don't ship them.
/docs/legislation/*.html
/docs/legislation/*_files/

# Editor / OS noise
*.swp
*.swo
Thumbs.db

# Workspace artefacts
node_modules/
.turbo/
.next/
next-env.d.ts
