# Database (Neon Postgres) — get from Neon dashboard
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Resend
RESEND_API_KEY=re_...
LICENSE_FROM_EMAIL="TachoLens <licenses@tacholens.com>"

# Resend inbound-email forwarding (https://resend.com/docs/dashboard/receiving)
# Webhook secret from the Resend dashboard for /api/resend/inbound.
RESEND_WEBHOOK_SECRET=whsec_...
# Where forwarded inbound mail lands (your real inbox).
RESEND_FORWARD_TO=me@example.com
# `from` address used when re-sending. Must be on a Resend-verified domain.
RESEND_FORWARD_FROM="TachoLens forwarder <forwarder@tacholens.com>"

# Ed25519 private key for signing license JWTs.
# Generate with: npm run keys:gen (writes to a temp file, paste below as one line)
# Newlines must be escaped as literal \n.
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4C...\n-----END PRIVATE KEY-----"

# Base URL used for Stripe success/cancel redirects.
# In Vercel set to https://tacholens.com; locally http://localhost:3000.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# GitHub fine-grained PAT with `Contents: read` on jakewtaylor/tacho-ui.
# Used server-side by /changelog (lists releases) and /api/download (resolves
# the .dmg asset to a signed S3 URL). Required since the repo is private.
GITHUB_API_TOKEN=github_pat_...
